  <script type="7c30cb8732344f65040c2b3a-text/javascript">
  /* ── Accessible nav dropdowns: click toggle + keyboard nav ── */
  (function() {
    function closeAll(except) {
      document.querySelectorAll('.nav-dropdown').forEach(function(dd) {
        if (dd === except) return;
        var btn = dd.querySelector('.nav-link');
        if (btn) btn.setAttribute('aria-expanded', 'false');
        dd.classList.remove('nav-dropdown--open');
      });
    }

    document.querySelectorAll('.nav-dropdown').forEach(function(dd) {
      var btn = dd.querySelector('.nav-link');
      var panel = dd.querySelector('.nav-dropdown-panel');
      if (!btn || !panel) return;

      btn.setAttribute('aria-haspopup', 'true');
      btn.setAttribute('aria-expanded', 'false');

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var open = btn.getAttribute('aria-expanded') === 'true';
        closeAll(dd);
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
        dd.classList.toggle('nav-dropdown--open', !open);
        if (!open) {
          var first = panel.querySelector('a');
          if (first) first.focus();
        }
      });

      btn.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          btn.setAttribute('aria-expanded', 'true');
          dd.classList.add('nav-dropdown--open');
          var first = panel.querySelector('a');
          if (first) first.focus();
        }
        if (e.key === 'Escape') {
          btn.setAttribute('aria-expanded', 'false');
          dd.classList.remove('nav-dropdown--open');
        }
      });

      panel.addEventListener('keydown', function(e) {
        var items = Array.from(panel.querySelectorAll('a'));
        var idx = items.indexOf(document.activeElement);
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (idx < items.length - 1) items[idx + 1].focus();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (idx > 0) items[idx - 1].focus();
          else btn.focus();
        } else if (e.key === 'Escape') {
          btn.setAttribute('aria-expanded', 'false');
          dd.classList.remove('nav-dropdown--open');
          btn.focus();
        }
      });

      dd.addEventListener('focusout', function(e) {
        setTimeout(function() {
          if (!dd.contains(document.activeElement)) {
            btn.setAttribute('aria-expanded', 'false');
            dd.classList.remove('nav-dropdown--open');
          }
        }, 0);
      });
    });

    document.addEventListener('click', function(e) {
      if (!e.target.closest('.nav-dropdown')) closeAll();
    });
  })();
  </script>
  
<script type="7c30cb8732344f65040c2b3a-text/javascript">
(function () {
  var input   = document.getElementById('doc-search-input');
  var countEl = document.getElementById('doc-search-count');
  var navEl   = document.getElementById('doc-search-nav');
  var prevBtn = document.getElementById('doc-search-prev');
  var nextBtn = document.getElementById('doc-search-next');
  if (!input) return;

  var body = document.querySelector('.document-html-body');
  if (!body) return;

  var matches = [];
  var current = -1;

  function escapeRe(s) {
    return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function updateCount() {
    if (matches.length === 0) {
      countEl.textContent = '0';
    } else {
      countEl.textContent = (current + 1) + ' / ' + matches.length;
    }
  }

  function goTo(index) {
    if (matches.length === 0) return;
    if (current >= 0 && current < matches.length) {
      matches[current].classList.remove('doc-search-match--first');
    }
    current = (index + matches.length) % matches.length;
    matches[current].classList.add('doc-search-match--first');
    matches[current].scrollIntoView({ behavior: 'smooth', block: 'center' });
    updateCount();
  }

  function clearHighlights() {
    body.querySelectorAll('mark.doc-search-match').forEach(function (m) {
      m.replaceWith(document.createTextNode(m.textContent));
    });
    body.normalize();
    matches = [];
    current = -1;
    countEl.textContent = '';
    navEl.hidden = true;
  }

  function applyHighlights(query) {
    var re = new RegExp('(' + escapeRe(query) + ')', 'gi');
    var walker = document.createTreeWalker(body, NodeFilter.SHOW_TEXT, null);
    var nodes = [];
    var node;
    while ((node = walker.nextNode())) {
      var p = node.parentElement;
      var skip = false;
      while (p && p !== body) {
        if (p.tagName === 'SCRIPT' || p.tagName === 'STYLE' || p.tagName === 'MARK') {
          skip = true;
          break;
        }
        p = p.parentElement;
      }
      if (!skip && re.test(node.nodeValue)) nodes.push(node);
      re.lastIndex = 0;
    }

    nodes.forEach(function (textNode) {
      var val = textNode.nodeValue;
      var frag = document.createDocumentFragment();
      var last = 0, m;
      re.lastIndex = 0;
      while ((m = re.exec(val)) !== null) {
        if (m.index > last) frag.appendChild(document.createTextNode(val.slice(last, m.index)));
        var mark = document.createElement('mark');
        mark.className = 'doc-search-match';
        mark.textContent = m[0];
        frag.appendChild(mark);
        last = m.index + m[0].length;
      }
      if (last < val.length) frag.appendChild(document.createTextNode(val.slice(last)));
      textNode.parentNode.replaceChild(frag, textNode);
    });

    matches = Array.from(body.querySelectorAll('mark.doc-search-match'));
  }

  var timer;
  input.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () {
      clearHighlights();
      var q = input.value.trim();
      if (q.length < 2) return;

      applyHighlights(q);

      if (matches.length === 0) {
        countEl.textContent = '0';
        navEl.hidden = true;
        return;
      }

      navEl.hidden = false;
      current = 0;
      matches[0].classList.add('doc-search-match--first');
      matches[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
      updateCount();
    }, 180);
  });

  prevBtn.addEventListener('click', function () { goTo(current - 1); });
  nextBtn.addEventListener('click', function () { goTo(current + 1); });

  // Allow Enter / Shift+Enter in the input to step through matches
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && matches.length > 0) {
      e.preventDefault();
      goTo(e.shiftKey ? current - 1 : current + 1);
    }
  });
})();
</script>

  <script type="7c30cb8732344f65040c2b3a-text/javascript">
  /* ── Quill rich-text note editors (lazy-loaded) ── */
  (function () {
    var TOOLBAR = [
      ['bold', 'italic', 'underline'],
      [{ list: 'ordered' }, { list: 'bullet' }]
    ];
    var quillLoaded = false;
    var quillLoading = false;

    function loadQuill(callback) {
      if (quillLoaded) { callback(); return; }
      if (quillLoading) { return; } // will be caught by next afterSwap
      quillLoading = true;
      // Load CSS
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css';
      document.head.appendChild(css);
      // Load JS
      var script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/quill@2/dist/quill.min.js';
      script.onload = function () { quillLoaded = true; quillLoading = false; callback(); };
      document.head.appendChild(script);
    }

    function initNoteEditors(root) {
      var wrappers = (root || document).querySelectorAll('.notes-quill-wrapper:not(.ql-initialized)');
      if (!wrappers.length) return;
      loadQuill(function () {
        wrappers.forEach(function (wrapper) { initSingleEditor(wrapper); });
      });
    }

    function initSingleEditor(wrapper) {
      wrapper.classList.add('ql-initialized');
      var form = wrapper.closest('form');
      var hidden = form && form.querySelector('input[name="body"]');
      var placeholder = wrapper.dataset.placeholder || '';

      var quill = new Quill(wrapper, { theme: 'snow', modules: { toolbar: TOOLBAR }, placeholder: placeholder });

      var initial = wrapper.dataset.initial;
      if (initial) quill.clipboard.dangerouslyPasteHTML(initial);

      if (form) {
        form.addEventListener('htmx:configRequest', function (e) {
          var html = quill.root.innerHTML;
          e.detail.parameters['body'] = (html === '<p><br></p>' || html === '') ? '' : html;
        });
        // Clear editor after successful note-add
        if (form.classList.contains('notes-add-form')) {
          form.addEventListener('htmx:afterRequest', function (e) {
            if (e.detail.successful) quill.root.innerHTML = '';
          });
        }
      }
    }

    document.addEventListener('DOMContentLoaded', initNoteEditors);
    // Use no-arg (searches full document) because outerHTML swaps detach the target element
    document.body.addEventListener('htmx:afterSwap', function () { initNoteEditors(); });
  })();

  /* ── HTMX global error handler ── */
  document.body.addEventListener('htmx:responseError', function (e) {
    var target = e.detail.target;
    if (target && target.querySelector) {
      var existing = target.querySelector('.htmx-error-msg');
      if (!existing) {
        var msg = document.createElement('p');
        msg.className = 'htmx-error-msg';
        msg.textContent = 'Failed to load content. Please try again.';
        msg.style.cssText = 'color:#991b1b;font-size:0.85rem;padding:0.75rem;text-align:center;';
        target.appendChild(msg);
      }
    }
  });

  /* ── HTMX afterSwap: modal root + chamber status bar ── */
  document.body.addEventListener('htmx:afterSwap', function (e) {
    var id = e.detail.target.id;
    if (id === 'modal-root') {
      var dialog = e.detail.target.querySelector('dialog');
      if (dialog) {
        var trigger = document.activeElement;
        dialog.showModal();
        dialog.addEventListener('click', function (ev) {
          if (ev.target === dialog) dialog.close();
        });
        dialog.addEventListener('close', function () {
          if (trigger && trigger.focus) trigger.focus();
        });
      }
    }
  });

  (function () {
    var btn = document.getElementById('back-to-top');
    function onScroll() { btn.hidden = window.scrollY < 300; }
    window.addEventListener('scroll', onScroll, { passive: true });
    btn.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();

  /* ── Font size control ── */
  (function () {
    const SIZES   = [100, 112, 125];  // percent values applied to <html>
    const KEY     = 'font_size_pref';
    const btnDec  = document.getElementById('font-decrease');
    const btnInc  = document.getElementById('font-increase');

    function applySize(idx) {
      document.documentElement.style.fontSize = SIZES[idx] + '%';
      btnDec.disabled = idx === 0;
      btnInc.disabled = idx === SIZES.length - 1;
      localStorage.setItem(KEY, idx);
    }

    var saved = parseInt(localStorage.getItem(KEY), 10);
    var current = (isNaN(saved) || saved < 0 || saved >= SIZES.length) ? 0 : saved;
    applySize(current);

    btnDec.addEventListener('click', function () { if (current > 0) applySize(--current); });
    btnInc.addEventListener('click', function () { if (current < SIZES.length - 1) applySize(++current); });
  })();

  (function () {
    const wrap    = document.getElementById('nav-search-wrap');
    const input   = document.getElementById('nav-search-input');
    const results = document.getElementById('nav-search-results');
    const loading = document.getElementById('nav-search-loading');
    const empty   = document.getElementById('nav-search-empty');
    const helpBtn = document.getElementById('nav-search-help-btn');
    const helpBox = document.getElementById('nav-search-help');

    function show(el) { el.style.display = ''; }
    function hide(el) { el.style.display = 'none'; }
    function closeResults() {
      hide(results);
      hide(loading);
      hide(empty);
      hide(helpBox);
    }

    helpBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      if (helpBox.style.display === 'none') {
        hide(results); hide(loading); hide(empty);
        show(helpBox);
      } else {
        hide(helpBox);
      }
    });

    // Biennium prefix of the page currently being viewed (e.g. '/b2023_24'),
    // or '' on the active biennium. Client-side navigations below must carry
    // it so a user browsing a historical biennium isn't bounced to the active
    // one by the bare-path redirect in BienniumPrefixMiddleware.
    var navPrefix = (function () {
      var m = location.pathname.match(/^\/(b\d{4}(?:_\d{2}|s))(?=\/|$)/);
      return m ? '/' + m[1] : '';
    })();

    function inferBillUrl(q) {
      if (/^["']/.test(q)) return null;
      var s = q.replace(/\s/g, '').toLowerCase();
      var m = s.match(/^([hs](?:cr|r|b))(\d+)$/);
      if (m) {
        var prefix = m[1].toUpperCase();
        var num = m[2];
        var normed = prefix + num;
        if (prefix === 'HB' || prefix === 'SB') return '/bills/' + normed + '/';
        return '/resolutions/' + normed + '/';
      }
      var dm = s.match(/^(\d+)$/);
      if (dm) {
        var n = parseInt(dm[1], 10);
        var p;
        if (n >= 1 && n <= 1599)      p = 'SB';
        else if (n >= 1601 && n <= 1699) p = 'SCR';
        else if (n >= 1701 && n <= 1999) p = 'SR';
        else if (n >= 2000 && n <= 4999) p = 'HB';
        else if (n >= 5000 && n <= 5999) p = 'HCR';
        else if (n >= 6000 && n <= 9999) p = 'HR';
        else return null;
        var normed = p + n;
        if (p === 'HB' || p === 'SB') return '/bills/' + normed + '/';
        return '/resolutions/' + normed + '/';
      }
      return null;
    }

    /* ── Quick bill lookup (nav bar) ── */
    (function () {
      var form = document.getElementById('nav-bill-lookup');
      var inp = document.getElementById('nav-bill-input');
      if (!form || !inp) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var q = inp.value.trim();
        if (!q) return;
        var url = inferBillUrl(q);
        if (url) {
          window.location.href = navPrefix + url;
        } else {
          window.location.href = navPrefix + '/search/?q=' + encodeURIComponent(q);
        }
      });
    })();

    /* ── Homepage hero search: intercept bare numbers ── */
    (function () {
      var form = document.querySelector('.hp-search-form');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        var q = form.querySelector('input[name="q"]');
        if (!q) return;
        var url = inferBillUrl(q.value.trim());
        if (url) {
          e.preventDefault();
          window.location.href = navPrefix + url;
        }
      });
    })();

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        const q = input.value.trim();
        if (q) {
          var direct = inferBillUrl(q);
          window.location.href = navPrefix + (direct || ('/search/?q=' + encodeURIComponent(q)));
        }
        e.preventDefault();
      }
      if (e.key === 'Escape') { closeResults(); input.blur(); }
    });

    document.addEventListener('click', function (e) {
      if (!wrap.contains(e.target)) closeResults();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        input.focus();
        input.select();
      }
    });

    let debounceTimer;
    input.addEventListener('input', function () {
      clearTimeout(debounceTimer);
      const q = input.value.trim();
      if (!q) { closeResults(); return; }
      debounceTimer = setTimeout(function () { runSearch(q); }, 400);
    });

    function runSearch(q) {
      hide(results);
      hide(empty);
      show(loading);
      fetch(navPrefix + '/search/api/?q=' + encodeURIComponent(q))
        .then(function (r) { return r.json(); })
        .then(function (data) {
          hide(loading);
          results.innerHTML = '';
          const hasLeg  = data.legislation && data.legislation.length;
          const hasStat = data.statutes && data.statutes.length;
          const hasDoc  = data.documents && data.documents.length;
          if (!hasLeg && !hasStat && !hasDoc) {
            hide(results);
            show(empty);
            return;
          }
          hide(empty);
          if (hasLeg) {
            results.appendChild(makeSection('Legislation'));
            data.legislation.forEach(function (hit) {
              const chamber = hit.chamber ? hit.chamber.charAt(0).toUpperCase() + hit.chamber.slice(1) : '';
              const meta = [hit.type.charAt(0).toUpperCase() + hit.type.slice(1), chamber].filter(Boolean).join(' · ');
              results.appendChild(makeResultItem(hit.url, hit.number, hit.shorttitle || '—', meta));
            });
          }
          if (hasStat) {
            results.appendChild(makeSection('Statutes'));
            data.statutes.forEach(function (hit) {
              results.appendChild(makeResultItem(hit.url, hit.number, hit.caption || '—', 'Kansas Statutes Annotated'));
            });
          }
          if (hasDoc) {
            results.appendChild(makeSection('Documents'));
            data.documents.forEach(function (hit) {
              const typeLabel = hit.doc_type === 'minutes' ? 'Minutes'
                : hit.doc_type === 'agenda_daily' ? 'Daily Agenda'
                : hit.doc_type === 'agenda_weekly' ? 'Weekly Agenda' : 'Testimony';
              const meta = hit.committee_name || '';
              results.appendChild(makeResultItem(hit.url, typeLabel, hit.title || hit.committee_name || '—', meta));
            });
          }
          const allLink = document.createElement('li');
          allLink.className = 'search-all-results-link';
          allLink.innerHTML = '<a href="' + navPrefix + '/search/?q=' + encodeURIComponent(q) + '">View all results for <strong>' + q.replace(/</g, '&lt;') + '</strong> &rsaquo;</a>';
          results.appendChild(allLink);
          show(results);
        })
        .catch(function () { hide(loading); });
    }

    function makeSection(label) {
      const li = document.createElement('li');
      li.className = 'search-section-heading';
      li.textContent = label;
      return li;
    }

    function makeResultItem(url, number, title, meta) {
      const li = document.createElement('li');
      li.className = 'search-result-item';
      // Build with textContent, not innerHTML — number/title/meta come from
      // TPOZ-derived search JSON and must not be parsed as HTML (DOM XSS).
      const a = document.createElement('a');
      // Index urls are stored bare (e.g. '/bills/HB2001/'); carry the viewed
      // biennium prefix so result clicks stay in that biennium.
      a.href = navPrefix + url;
      a.className = 'search-result-link';
      const numSpan = document.createElement('span');
      numSpan.className = 'search-result-number';
      numSpan.textContent = number;
      const body = document.createElement('span');
      body.className = 'search-result-body';
      const titleSpan = document.createElement('span');
      titleSpan.className = 'search-result-title';
      titleSpan.textContent = title;
      const metaSpan = document.createElement('span');
      metaSpan.className = 'search-result-meta';
      metaSpan.textContent = meta;
      body.appendChild(titleSpan);
      body.appendChild(metaSpan);
      a.appendChild(numSpan);
      a.appendChild(body);
      li.appendChild(a);
      return li;
    }
  })();
  </script>
  <script type="7c30cb8732344f65040c2b3a-text/javascript">
  /* ── PDF link accessibility — badge + aria-label on all PDF links ── */
  (function () {
    function tagPdfLinks(root) {
      var links = (root || document).querySelectorAll(
        'a[href*="download"], a[href$=".pdf"], a[href*=".pdf?"], a[href*=".pdf#"]'
      );
      for (var i = 0; i < links.length; i++) {
        var a = links[i];
        if (a.dataset.pdfTagged) continue;
        var href = a.getAttribute('href') || '';
        var path = href.split('?')[0];
        if (path.indexOf('view-leg') !== -1 || path.indexOf('view-doc') !== -1) continue;
        if (!path.match(/\/download\/?$|\.pdf$/i)) continue;
        a.dataset.pdfTagged = '1';

        var pdfIcons = a.querySelectorAll('.material-symbols-outlined');
        for (var j = pdfIcons.length - 1; j >= 0; j--) {
          if ((pdfIcons[j].textContent || '').trim() === 'picture_as_pdf') {
            pdfIcons[j].remove();
          }
        }

        if (!a.querySelector('.pdf-badge')) {
          var badge = document.createElement('span');
          badge.className = 'pdf-badge';
          badge.setAttribute('aria-hidden', 'true');
          badge.textContent = 'PDF';
          var firstChild = a.firstChild;
          if (firstChild) {
            a.insertBefore(badge, firstChild);
          } else {
            a.appendChild(badge);
          }
        }

        if (!a.getAttribute('aria-label')) {
          var text = (a.textContent || '').replace(/\s+/g, ' ').trim();
          var label = text.replace(/\bPDF\b/i, '').trim();
          if (a.getAttribute('target') === '_blank') {
            a.setAttribute('aria-label', label + ' (PDF, opens in new tab)');
          } else {
            a.setAttribute('aria-label', label + ' (PDF)');
          }
        }
      }
    }
    document.addEventListener('DOMContentLoaded', function () { tagPdfLinks(); });
    document.body.addEventListener('htmx:afterSettle', function (e) { tagPdfLinks(e.detail.elt); });
  })();
  </script>
