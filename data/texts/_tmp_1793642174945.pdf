<script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js" type="5b727bb92bd5d299c1724a5d-text/javascript"></script>
  <script src="/static/js/nav.09310fa6afd5.js" type="5b727bb92bd5d299c1724a5d-text/javascript"></script>
  <script src="/static/js/reveals.355eeeab4029.js" type="5b727bb92bd5d299c1724a5d-text/javascript"></script>
